{
  "model_profile": "balanced",
  "commit_docs": true,
  "parallelization": true,
  "search_gitignored": false,
  "brave_search": false,
  "firecrawl": false,
  "exa_search": false,
  "tavily_search": false,
  "ref_search": false,
  "perplexity": false,
  "jina": false,
  "git": {
    "branching_strategy": "none",
    "create_tag": true,
    "phase_branch_template": "gsd/phase-{phase}-{slug}",
    "milestone_branch_template": "gsd/{milestone}-{slug}",
    "quick_branch_template": null
  },
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": true,
    "auto_advance": false,
    "node_repair": true,
    "node_repair_budget": 2,
    "ui_phase": true,
    "ui_safety_gate": true,
    "ai_integration_phase": true,
    "api_coverage_gate": true,
    "human_verify_mode": "end-of-phase",
    "context_guard_mode": "warn",
    "text_mode": false,
    "compact_content": false,
    "research_before_questions": false,
    "discuss_mode": "discuss",
    "skip_discuss": false,
    "code_review": true,
    "code_review_depth": "standard",
    "code_review_command": null,
    "pattern_mapper": true,
    "plan_bounce": false,
    "plan_bounce_script": null,
    "plan_bounce_passes": 2,
    "auto_prune_state": false,
    "post_planning_gaps": true,
    "security_enforcement": true,
    "security_asvs_level": 1,
    "security_block_on": "high",
    "ui_review": true
  },
  "ship": {
    "pr_body_sections": []
  },
  "hooks": {
    "context_warnings": true
  },
  "project_code": null,
  "phase_naming": "sequential",
  "agent_skills": {},
  "claude_md_path": "./.claude/CLAUDE.md",
  "plan_review": {
    "source_grounding": true,
    "source_grounding_authority": "grep"
  },
  "mode": "interactive",
  "granularity": "standard",
  "context_window": 200000,
  "claude_md_assembly": {
    "mode": "link"
  },
  "model_overrides": {
    "gsd-codebase-mapper": "claude-haiku-5-5",
    "gsd-pattern-mapper": "claude-haiku-5-5",
    "gsd-research-synthesizer": "claude-haiku-5-5",
    "gsd-doc-classifier": "claude-haiku-5-5"
  },
  "resolve_model_ids": "omit",
  "dynamic_routing": {
    "enabled": false
  },
  "model_profile_overrides": {
    "claude": {
      "opus": "claude-opus-5-5",
      "sonnet": "claude-sonnet-5-5",
      "haiku": "claude-haiku-5-5"
    }
  },
  "models": {
    "planning": "sonnet",
    "discuss": "sonnet",
    "research": "sonnet",
    "execution": "sonnet",
    "verification": "sonnet",
    "completion": "sonnet"
  },
  "effort": {
    "default": "medium",
    "routing_tier_defaults": {
      "light": "low",
      "standard": "medium",
      "heavy": "medium"
    },
    "agent_overrides": {
      "gsd-codebase-mapper": "low",
      "gsd-pattern-mapper": "low",
      "gsd-research-synthesizer": "low",
      "gsd-doc-classifier": "low",
      "gsd-verifier": "high",
      "gsd-plan-checker": "high",
      "gsd-integration-checker": "high",
      "gsd-nyquist-auditor": "high",
      "gsd-ui-checker": "high",
      "gsd-ui-auditor": "high",
      "gsd-doc-verifier": "high",
      "gsd-dom-verifier": "high",
      "gsd-code-reviewer": "high",
      "gsd-eval-auditor": "high",
      "gsd-security-auditor": "high",
      "gsd-debugger": "high"
    }
  }
}
